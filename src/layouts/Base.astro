---
import '../styles/global.css';
import Icon, { type IconName } from '../components/Icon.astro';
import { url } from '../lib/url';
import { COMMUNITY_WIKI_URL, REPO_URL, SITE_NAME, WORKSHOP_CHANGELOG_URL, WORKSHOP_URL } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  /** Keep the page out of search engines (the labeling tool). */
  noindex?: boolean;
}
const { title, description = '《福佑大乱斗》福佑图鉴、英雄搭配、版本变动与攻略', noindex = false } = Astro.props;
const fullTitle = title ? `${title} · 福佑大乱斗` : SITE_NAME;
const home = url('/');
const path = Astro.url.pathname;
const at = (p: string) => path.startsWith(url(p));

type Section = 'catalog' | 'compare' | 'heroes' | 'versions' | 'guides' | 'label' | 'more';
const section: Section | undefined =
  path === home || at('/blessings/')
    ? 'catalog'
    : at('/compare/')
      ? 'compare'
      : at('/heroes/')
        ? 'heroes'
        : at('/versions/')
          ? 'versions'
          : at('/guides/')
            ? 'guides'
            : at('/label/')
              ? 'label'
              : at('/more/')
                ? 'more'
                : undefined;

const tabs: { id: Section; href: string; label: string; icon: IconName }[] = [
  { id: 'catalog', href: home, label: '图鉴', icon: 'catalog' },
  { id: 'compare', href: url('/compare/'), label: '对比', icon: 'compare' },
  { id: 'heroes', href: url('/heroes/'), label: '英雄', icon: 'heroes' },
  { id: 'versions', href: url('/versions/'), label: '版本', icon: 'versions' },
  { id: 'guides', href: url('/guides/'), label: '攻略', icon: 'guides' },
];
// Secondary pages live under 更多 on phones.
const moreLinks: { id: Section; href: string; label: string; hint: string; icon: IconName }[] = [
  { id: 'versions', href: url('/versions/'), label: '版本变动', hint: '按时间倒序', icon: 'versions' },
  { id: 'guides', href: url('/guides/'), label: '攻略文章', hint: '新手与进阶', icon: 'guides' },
  { id: 'label', href: url('/label/'), label: '品质标注', hint: '站长工具', icon: 'label' },
];
const inMore = section === 'versions' || section === 'guides' || section === 'label' || section === 'more';
const dock: { href: string; label: string; icon: IconName; current: boolean; sheet?: boolean }[] = [
  { href: home, label: '图鉴', icon: 'catalog', current: section === 'catalog' },
  { href: url('/compare/'), label: '对比', icon: 'compare', current: section === 'compare' },
  { href: url('/heroes/'), label: '英雄', icon: 'heroes', current: section === 'heroes' },
  { href: url('/more/'), label: '更多', icon: 'more', current: inMore, sheet: true },
];
// Self-hosted CJK display subset (tools/subset-display-font.ts); declared here so the URL carries the base path.
const displayFontFace = `@font-face{font-family:'Fuyou Display';font-style:normal;font-weight:900;font-display:swap;src:url(${url('/fonts/fuyou-display-900.woff2')}) format('woff2')}`;
const mark = [
  'M4 3h5L6 17H1z',
  'M11 3h5l-3 14H8z',
  'M18 3h4l-3 14h-4z',
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#121826" />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{fullTitle}</title>
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <style is:inline set:html={displayFontFace}></style>
    <script is:inline>
      // Dark is the house scene; light is an explicit choice that persists.
      try {
        if (localStorage.getItem('theme') === 'light') document.documentElement.dataset.theme = 'light';
      } catch {}
    </script>
    <script is:inline>
      // Page transitions: name the tapped card's icon and name so they morph into the detail header, and
      // on the way back name the card the header returns to. Parser-blocking on purpose: pagereveal fires
      // before the first frame. Detail headers carry their names in CSS (global.css, page transitions).
      (() => {
        if (!('onpagereveal' in window)) return;
        const KINDS = {
          blessings: { card: '.slot, .pc', icon: '.ic', name: 'h2, h3, h4', header: '.lt3', vt: 'bl' },
          heroes: { card: '.hero-tile, .hero-chip', icon: '.hero-img', name: '.name-strap', header: '.hero-lt', vt: 'hero' },
        };
        let named = [];
        const clear = () => {
          for (const el of named) el.style.viewTransitionName = '';
          named = [];
        };
        const name = (el, vt) => {
          if (!el) return;
          el.style.viewTransitionName = vt;
          named.push(el);
        };
        const mark = (target, transition) => {
          const path = target && new URL(target, location.href).pathname;
          const m = path && path.match(/\/(blessings|heroes)\/[^/]+\/$/);
          if (!m) return;
          const k = KINDS[m[1]];
          // This page's own header already holds the names; a second holder would cancel the transition.
          if (document.querySelector(k.header)) return;
          const vh = innerHeight;
          for (const a of document.querySelectorAll('a[href]')) {
            if (a.pathname !== path) continue;
            const card = a.closest(k.card);
            if (!card) continue;
            const r = card.getBoundingClientRect();
            if (r.height === 0 || r.bottom <= 0 || r.top >= vh) continue;
            name(card.querySelector(k.icon), k.vt + '-icon');
            name(card.querySelector(k.name), k.vt + '-name');
            break;
          }
          transition.finished.finally(clear);
        };
        let clicked = null;
        addEventListener(
          'click',
          (e) => {
            const a = e.target instanceof Element ? e.target.closest('a[href]') : null;
            clicked = a ? a.href : null;
          },
          true,
        );
        addEventListener('pageswap', (e) => {
          clear();
          if (!e.viewTransition) return;
          mark(e.activation ? e.activation.entry.url : clicked, e.viewTransition);
          try {
            sessionStorage.setItem('vt-from', location.href);
          } catch {}
        });
        addEventListener('pagereveal', (e) => {
          clear(); // a page restored from the back-forward cache may still hold names from leaving it
          if (!e.viewTransition) return;
          let from = null;
          try {
            from = navigation.activation.from.url;
          } catch {}
          if (!from) {
            try {
              from = sessionStorage.getItem('vt-from');
            } catch {}
          }
          mark(from, e.viewTransition);
        });
      })();
    </script>
  </head>
  <body>
    <header class="topbar">
      <div class="topbar-in">
      <a class="brand" href={home} aria-label="福佑图鉴 首页">
        <svg width="24" height="20" viewBox="0 0 23 20" aria-hidden="true">
          <path d={mark[0]} fill="var(--q-ssr)" /><path d={mark[1]} fill="var(--q-sr)" /><path d={mark[2]} fill="var(--q-r)" />
        </svg>
        <span>福佑图鉴</span>
      </a>
      <nav class="tabs" aria-label="主导航">
        {
          tabs.map((t) => (
            <a class="tab bar" href={t.href} aria-current={section === t.id ? 'page' : undefined}>
              {t.label}
            </a>
          ))
        }
      </nav>
      <div class="topbar-end">
        <slot name="score" />
        <button id="theme-toggle" class="icon-btn" type="button" aria-label="切换深浅色" title="切换深浅色">
          <Icon name="theme" />
        </button>
      </div>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <p>
        非官方玩家攻略站，可能滞后于游戏版本。发现错误？<a href={REPO_URL}>在 GitHub 上提交修改</a>
      </p>
      <p class="credit-line">
        数据参考：<a href={WORKSHOP_URL} rel="noopener">游戏文件</a> · <a href={COMMUNITY_WIKI_URL} rel="noopener">社区图鉴站</a> ·
        <a href={WORKSHOP_CHANGELOG_URL} rel="noopener">Steam 改动记录</a>
      </p>
    </footer>
    <nav class="dock" aria-label="底部导航">
      {
        dock.map((d) => (
          <a href={d.href} aria-current={d.current ? 'page' : undefined} data-sheet={d.sheet ? '' : undefined}>
            <Icon name={d.icon} size={22} />
            {d.label}
          </a>
        ))
      }
    </nav>
    <div id="more-sheet" class="more-sheet" popover>
      <h2>更多</h2>
      <ul class="more-list">
        {
          moreLinks.map((m) => (
            <li>
              <a class="bar" href={m.href} aria-current={section === m.id ? 'page' : undefined}>
                <Icon name={m.icon} />
                {m.label}
                <small>{m.hint}</small>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <script>
      const root = document.documentElement;
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const next = root.dataset.theme === 'light' ? 'dark' : 'light';
        if (next === 'light') root.dataset.theme = 'light';
        else delete root.dataset.theme;
        try {
          localStorage.setItem('theme', next);
        } catch {}
      });
      // 更多 opens a bottom sheet where the popover API exists; otherwise it is a plain link to /more/.
      const sheet = document.getElementById('more-sheet');
      const moreLink = document.querySelector<HTMLAnchorElement>('.dock a[data-sheet]');
      if (sheet && moreLink && 'togglePopover' in sheet) {
        moreLink.setAttribute('aria-haspopup', 'dialog');
        moreLink.addEventListener('click', (e) => {
          e.preventDefault();
          sheet.togglePopover();
        });
      }
    </script>
  </body>
</html>
