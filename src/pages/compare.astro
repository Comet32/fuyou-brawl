---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { publicFileExists } from '../lib/assets';
import { toCardRecord } from '../lib/card-data';
import { isHeroBlessing } from '../lib/hero-blessing';
import { heroLinks } from '../lib/hero-links-data';
import { MAX_COMPARE } from '../lib/compare';
import { safeJson } from '../lib/json';

const blessings = (await getCollection('blessings'))
  .map((e) => e.data)
  .sort((a, b) => a.name.localeCompare(b.name, 'zh-CN') || a.id.localeCompare(b.id));
// Cards are drawn on the client from this data; no hidden pool of 675 server-rendered cards.
const heroes = new Map((await getCollection('heroes')).map((e) => [e.data.id, e.data]));
const { byBlessing } = heroLinks();
// Suggestions always include hero blessings (they are offered in-match), marked with their hero.
const heroOf = (id: string) => {
  const h = isHeroBlessing(id) ? heroes.get(byBlessing.get(id)?.[0]?.hero ?? '') : undefined;
  if (!h) return undefined;
  const img = `img/heroes/${h.id}.webp`;
  return { id: h.id, name: h.name, ...(publicFileExists(img) ? { img } : {}) };
};
const records = blessings.map((b) =>
  toCardRecord(b, Boolean(b.icon && publicFileExists(`img/blessings/${b.icon}`)), heroOf(b.id)),
);
const slots = Array.from({ length: MAX_COMPARE }, (_, i) => i);
---

<Base title="三选一对比" description="对局里抽到三个福佑？分别搜出来并排比较。">
  <div class="board-head">
    <h1 class="page-title">三选一对比</h1>
    <p class="page-lede">每格输入名称或首字母，回车锁定第一个结果并跳到下一格。锁定后的链接可以直接分享。</p>
  </div>
  <div class="board">
    {
      slots.map((i) => (
        <section class="pick" data-slot={i} aria-label={`第 ${i + 1} 个福佑`}>
          <div class="pick-head">
            <span class="pick-lock" aria-hidden="true" />
            <button class="pick-toggle" type="button" aria-label={`重新选择第 ${i + 1} 个福佑`} disabled>
              <span class="pick-no num" aria-hidden="true">{i + 1}</span>
              <span class="pick-state">
                <span class="pick-idle">待选</span>
                <span class="pick-stamp" hidden>
                  <Icon name="lock" size={16} />
                  已锁定
                </span>
              </span>
              <span class="pick-quality" hidden></span>
              <span class="pick-repick" hidden>点此换</span>
            </button>
            <button class="icon-btn pick-clear" type="button" aria-label={`清空第 ${i + 1} 格`} hidden>
              <Icon name="close" />
            </button>
          </div>
          <div class="pick-field">
            <div class="field field-sm">
              <label class="field-cap" for={`pick-${i}`}>
                <Icon name="search" />
                <span class="sr-only">搜索第 {i + 1} 个福佑</span>
              </label>
              <input
                id={`pick-${i}`}
                type="search"
                placeholder={`福佑 ${i + 1}：名称 / 首字母`}
                autocomplete="off"
                autocapitalize="off"
                spellcheck="false"
                enterkeyhint={i === MAX_COMPARE - 1 ? 'done' : 'next'}
                aria-controls={`suggest-${i}`}
              />
            </div>
            <ul id={`suggest-${i}`} class="suggest" aria-label="候选福佑" hidden />
          </div>
          <div class="pick-card" data-empty="空位：搜索并锁定一个福佑" aria-live="polite" />
        </section>
      ))
    }
  </div>
  <noscript><p class="page-lede">对比需要启用 JavaScript；也可以在图鉴里逐个查看。</p></noscript>
  <script type="application/json" id="card-data" set:html={safeJson(records)} />
  <script>
    import { initComparePage } from '../scripts/compare-page';
    initComparePage();
  </script>
</Base>
