---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { url } from '../../lib/url';

const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
---

<Base title="攻略">
  <h1 class="page-title">攻略文章</h1>
  <p class="page-lede">从入门到进阶，按推荐阅读顺序排列。</p>
  {
    guides.length === 0 && (
      <div class="empty-state">
        <h2>还没有攻略文章</h2>
        <p>攻略写在 src/content/guides/ 下，一篇一个 Markdown 文件。</p>
      </div>
    )
  }
  <ol class="guide-list">
    {
      guides.map((g, i) => (
        <li>
          <a class="guide-row" href={url(`/guides/${g.id}/`)}>
            <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span>
              <strong>{g.data.title}</strong>
              <span class="desc">{g.data.description}</span>
            </span>
            <Icon name="next" />
          </a>
        </li>
      ))
    }
  </ol>
</Base>
