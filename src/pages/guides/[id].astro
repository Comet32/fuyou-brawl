---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { describeSource, loadSources } from '../../lib/sources';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((g) => ({ params: { id: g.id }, props: { guide: g } }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
const registry = loadSources(process.cwd());
const sources = guide.data.sources.map((s) => describeSource(s, registry));
---

<Base title={guide.data.title} description={guide.data.description}>
  <nav class="crumbs" aria-label="页面导航">
    <a href={url('/guides/')}><Icon name="back" size={18} />全部攻略</a>
  </nav>
  <article class="prose">
    <h1>{guide.data.title}</h1>
    <p class="meta-line">更新于 <span class="num">{guide.data.updated}</span></p>
    <Content />
    {
      sources.length > 0 && (
        <Fragment>
          <h2>参考来源</h2>
          <ul class="source-list">
            {sources.map(({ href, parts: [title, ...rest] }) => (
              <li>
                <a class="link-inline" href={href} target="_blank" rel="noopener">
                  {title}
                  <Icon name="external" />
                </a>
                {rest.length > 0 && <span class="muted"> · {rest.join(' · ')}</span>}
              </li>
            ))}
          </ul>
        </Fragment>
      )
    }
  </article>
</Base>
