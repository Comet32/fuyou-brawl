---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import BlessingIcon from '../../components/BlessingIcon.astro';
import HeroImage from '../../components/HeroImage.astro';
import Icon from '../../components/Icon.astro';
import Template from '../../components/Template.astro';
import { heroesForBlessing } from '../../lib/hero-blessings';
import { isHeroBlessing } from '../../lib/hero-blessing';
import { heroLinks } from '../../lib/hero-links-data';
import { qualityOf } from '../../lib/quality';
import { isPossiblyOutdated, parseRange, sourceLink } from '../../lib/community';
import { COMMUNITY_VIDEO_URL, COMMUNITY_WIKI_URL, GAME_VERSION, REPO_URL } from '../../lib/site';
import { placeholderKeys, toPlainText } from '../../lib/template';
import { OVERRIDES_FILE } from '../../lib/blessings';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const blessings = await getCollection('blessings');
  return blessings.map((e) => ({ params: { id: e.data.id }, props: { blessing: e.data } }));
}

const { blessing } = Astro.props;
const quality = qualityOf(blessing.quality);
const builds = (await getCollection('builds')).map((e) => e.data);
const heroes = new Map((await getCollection('heroes')).map((e) => [e.data.id, e.data]));
const recommendedBy = heroesForBlessing(blessing.id, builds)
  .map((id) => heroes.get(id))
  .filter((h) => h !== undefined);
const exclusive = blessing.exclusive_hero ? heroes.get(blessing.exclusive_hero) : undefined;
// Heroes this blessing is about (ability-name links or manual `heroes:` in overrides).
const related = (heroLinks().byBlessing.get(blessing.id) ?? [])
  .map((l) => ({ hero: heroes.get(l.hero), ability: l.ability }))
  .filter((x): x is { hero: NonNullable<typeof x.hero>; ability: string } => x.hero !== undefined);
const heroBlessing = isHeroBlessing(blessing.id);
const owner = heroBlessing ? related[0]?.hero : undefined;
// Every placeholder of the full effect, then any that only the summary uses.
const keys = [...new Set([...placeholderKeys(blessing.effect), ...placeholderKeys(blessing.summary)])];
const knownCount = keys.filter((k) => Object.hasOwn(blessing.numbers, k)).length;
const editUrl = `${REPO_URL}/edit/main/${OVERRIDES_FILE}`;
const qualitySource = blessing.quality_source === 'community' && blessing.quality_url ? sourceLink(blessing.quality_url) : undefined;
// Stat sheet rows: value (plain or "a~b" range) and, for community values, where it came from.
const rows = keys.map((key) => {
  const known = Object.hasOwn(blessing.numbers, key);
  const value = known ? blessing.numbers[key] : undefined;
  const src = blessing.number_sources[key];
  return { key, value, range: value === undefined ? undefined : parseRange(value), src: src ? sourceLink(src) : undefined };
});
const hasRange = rows.some((r) => r.range);
const tips = blessing.tips.map((t) => ({
  ...t,
  link: t.source ? sourceLink(t.source) : undefined,
  stale: isPossiblyOutdated(t.date, GAME_VERSION),
}));
// Community picks, separate from the automatic hero links above them.
const communityHeroes = blessing.recommended_heroes
  .map((r) => ({ hero: heroes.get(r.hero), link: sourceLink(r.source) }))
  .filter((x): x is { hero: NonNullable<typeof x.hero>; link: ReturnType<typeof sourceLink> } => x.hero !== undefined);
const communityHeroLabels = [...new Set(communityHeroes.map((x) => x.link.label))];
const usesCommunity =
  qualitySource !== undefined ||
  Object.keys(blessing.number_sources).length > 0 ||
  communityHeroes.length > 0 ||
  tips.some((t) => t.link) ||
  blessing.quality_note !== undefined;
---

<Base title={blessing.name} description={toPlainText(blessing.summary, blessing.numbers)}>
  <nav class="crumbs" aria-label="页面导航">
    <a href={url('/')}><Icon name="back" size={18} />图鉴</a>
    <a href={url(`/compare/?ids=${blessing.id}`)}><Icon name="compare" size={18} />放进三选一对比</a>
  </nav>

  <header class="lt3" data-q={quality?.id}>
    <div class="lt" data-q={quality?.id}>
    <BlessingIcon blessing={blessing} size={128} eager />
    <h1>{blessing.name}</h1>
    {blessing.name_en && <p class="en">{blessing.name_en}</p>}
    <div class="lt-tags">
      {blessing.tags.map((t) => <a class="tag bar" href={url(`/?tag=${encodeURIComponent(t)}`)}>{t}</a>)}
      {exclusive && <a class="tag bar" href={url(`/heroes/${exclusive.id}/`)}>专属：{exclusive.name}</a>}
      {
        owner && (
          <a class="hero-strap lt-hero" href={url(`/heroes/${owner.id}/`)}>
            <HeroImage hero={owner} eager />
            英雄福佑 · {owner.name}
          </a>
        )
      }
    </div>
    </div>
    <p class="lt-band">
      {
        qualitySource && (
          <a class="lt-src" href={qualitySource.href} target="_blank" rel="noopener">品质来源：{qualitySource.label}</a>
        )
      }
      <span>{quality ? `${quality.label}品质` : '品质未标注'}</span>
    </p>
  </header>
  {blessing.quality_note && <p class="note q-note">品质未定：{blessing.quality_note}</p>}

  <div class="detail-grid">
    <div>
    <section aria-labelledby="effect-h">
      <h2 id="effect-h" class="strap">完整效果</h2>
      <p class="effect"><Template tpl={blessing.effect} numbers={blessing.numbers} /></p>
      {
        blessing.summary !== blessing.effect && (
          <Fragment>
            <h2 class="strap">选取时的简介</h2>
            <p class="effect sm"><Template tpl={blessing.summary} numbers={blessing.numbers} /></p>
          </Fragment>
        )
      }
    </section>

    <section aria-labelledby="tips-h">
      <h2 id="tips-h" class="strap">玩家心得<span class="num">{tips.length}</span></h2>
      {
        tips.length > 0 ? (
          <ul class="tips">
            {tips.map((t) => (
              <li>
                <p>{t.text}</p>
                {(t.link || t.date || t.stale) && (
                  <p class="tip-meta">
                    {t.link && (
                      <a href={t.link.href} target="_blank" rel="noopener">
                        {t.link.label}
                        <Icon name="external" size={14} />
                      </a>
                    )}
                    {t.date && <span class="num">{t.date}</span>}
                    {t.stale && <span class="stale" title={`早于 ${GAME_VERSION} 版本半年以上`}>可能过时</span>}
                  </p>
                )}
              </li>
            ))}
          </ul>
        ) : (
          <p class="note">
            还没有这个福佑的心得。用过它？在 <code>{OVERRIDES_FILE}</code> 里给它加一条 <code>tips</code>：一句话、用自己的话写，最好附上来源链接。
            <a class="link-inline" href={editUrl} target="_blank" rel="noopener"><Icon name="edit" />在 GitHub 上补充</a>
          </p>
        )
      }
    </section>
    </div>

    <section aria-labelledby="stats-h">
      <h2 id="stats-h" class="strap">数值表<span class="num">{knownCount}/{keys.length}</span></h2>
      {
        keys.length > 0 ? (
          <table class="stats">
            <thead>
              <tr>
                <th scope="col">占位符</th>
                <th scope="col">数值</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((r) => (
                <tr>
                  <th scope="row">{r.key}</th>
                  <td>
                    {r.value === undefined ? (
                      <i class="u">待补充</i>
                    ) : r.range ? (
                      <b class="v rng">
                        {r.range[0]}
                        <span class="tilde">~</span>
                        {r.range[1]}
                      </b>
                    ) : (
                      <b class="v">{String(r.value)}</b>
                    )}
                    {r.src && (
                      <sup class="src-mark">
                        <a href={r.src.href} target="_blank" rel="noopener" title={`来源：${r.src.label}`}>
                          {r.src.short}
                        </a>
                      </sup>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        ) : (
          <p class="note">这个福佑的描述里没有可变数值。</p>
        )
      }
      {
        hasRange && (
          <p class="note">「200~400」这样的区间照社区图鉴原样记录，来源没有说明它随等级、时间还是随机变化。</p>
        )
      }
      <p class="note">
        数值记录在 <code>{OVERRIDES_FILE}</code>，按占位符名填写，会覆盖社区数据；不知道的保持空着，页面会显示「待补充」。
        <a class="link-inline" href={editUrl} target="_blank" rel="noopener"><Icon name="edit" />在 GitHub 上补充</a>
      </p>
    </section>
  </div>

  {
    related.length > 0 && (
      <section aria-labelledby="related-h">
        <h2 id="related-h" class="strap">相关英雄</h2>
        <ul class="hero-grid">
          {related.map(({ hero: h, ability }) => (
            <li>
              <a class="hero-tile" href={url(`/heroes/${h.id}/`)}>
                <HeroImage hero={h} eager />
                <span class="name-strap">{h.name}</span>
                {ability && <span class="ability-strap">{ability}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    communityHeroes.length > 0 && (
      <section aria-labelledby="community-heroes-h">
        <h2 id="community-heroes-h" class="strap">社区推荐英雄<span class="num">{communityHeroes.length}</span></h2>
        <ul class="hero-chips">
          {communityHeroes.map(({ hero: h }) => (
            <li>
              <a class="hero-chip" href={url(`/heroes/${h.id}/`)}>
                <HeroImage hero={h} />
                {h.name}
              </a>
            </li>
          ))}
        </ul>
        <p class="note">来自{communityHeroLabels.join('、')}里的福佑推荐，仅供参考。</p>
      </section>
    )
  }

  {
    /* With community picks above, an empty "no build recommends this" note would only contradict them. */
    (recommendedBy.length > 0 || communityHeroes.length === 0) && (
      <section aria-labelledby="heroes-h">
        <h2 id="heroes-h" class="strap">推荐搭配的英雄</h2>
        {recommendedBy.length > 0 ? (
          <ul class="hero-grid">
            {recommendedBy.map((h) => (
              <li>
                <a class="hero-tile" href={url(`/heroes/${h.id}/`)}>
                  <HeroImage hero={h} eager />
                  <span class="name-strap">{h.name}</span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="note">
            还没有英雄搭配推荐这个福佑。
            <a class="link-inline" href={url('/heroes/')}>去英雄页看看</a>
          </p>
        )}
      </section>
    )
  }

  <section aria-labelledby="history-h">
    <h2 id="history-h" class="strap">改动历史</h2>
    {
      blessing.history.length > 0 ? (
        <ol class="plain-list">
          {blessing.history.map((h) => (
            <li>
              <a class="num" href={url(`/versions/#v-${h.version}`)}>{h.version}</a>
              {h.change}
            </li>
          ))}
        </ol>
      ) : (
        <p class="note">{blessing.since_version ? `自 ${blessing.since_version} 起暂无改动记录。` : '暂无改动记录。'}</p>
      )
    }
  </section>

  {
    (blessing.sources.length > 0 || usesCommunity) && (
      <section class="credits" aria-labelledby="sources-h">
        <h2 id="sources-h" class="strap">资料来源</h2>
        <ul>
          {blessing.sources.map((s) => (
            <li>
              <a class="link-inline" href={s} target="_blank" rel="noopener">
                {sourceLink(s).label}
                <Icon name="external" />
              </a>
              <span class="muted">{s}</span>
            </li>
          ))}
          {usesCommunity && (
            <li>
              <a class="link-inline" href={COMMUNITY_WIKI_URL} target="_blank" rel="noopener">
                社区图鉴站「福佑大乱斗 技能图鉴」
                <Icon name="external" />
              </a>
              <span class="muted">
                整理自 B站视频
                <a href={COMMUNITY_VIDEO_URL} target="_blank" rel="noopener">BV1feAHzJEGH</a>
                （--君往何处--）所附的腾讯文档；品质、区间数值和英雄一图流大多出自这里。
              </span>
            </li>
          )}
        </ul>
        {usesCommunity && <p class="note">心得是本站的转述，不是原文；和游戏实际不符时以游戏为准。</p>}
      </section>
    )
  }
</Base>
