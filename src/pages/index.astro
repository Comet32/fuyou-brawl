---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import BlessingCard from '../components/BlessingCard.astro';
import Icon from '../components/Icon.astro';
import { isHeroBlessing } from '../lib/hero-blessing';
import { heroLinks } from '../lib/hero-links-data';
import { QUALITIES } from '../lib/quality';
import { TAGS } from '../lib/tags';
import { toSearchRecord } from '../lib/search-record';
import { safeJson } from '../lib/json';
import { url } from '../lib/url';

const blessings = (await getCollection('blessings'))
  .map((e) => e.data)
  .sort((a, b) => a.name.localeCompare(b.name, 'zh-CN') || a.id.localeCompare(b.id));
const records = blessings.map(toSearchRecord);
const tags = TAGS.filter((t) => blessings.some((b) => b.tags.includes(t)));
const heroes = new Map((await getCollection('heroes')).map((e) => [e.data.id, e.data]));
const { byBlessing } = heroLinks();
// Hero blessings carry a strap with their hero; they are hidden by default (toggle 含英雄福佑).
const heroOf = (id: string) => {
  if (!isHeroBlessing(id)) return undefined;
  const link = byBlessing.get(id)?.[0];
  return link ? heroes.get(link.hero) : undefined;
};
const general = blessings.filter((b) => !isHeroBlessing(b.id));
const heroCount = blessings.length - general.length;
const tally = (q: string | null) => general.filter((b) => b.quality === q).length;
// No query: the draft pool grouped by quality, each card inside its color family.
const groups = [
  ...QUALITIES.map((q) => ({ id: q.id as string, q: q.id as string | undefined, label: q.label })),
  { id: 'none', q: undefined, label: '未标注' },
].map((g) => ({ ...g, items: blessings.filter((b) => (b.quality ?? 'none') === g.id) }));
// First screen of the default grouped view (hero blessings hidden): 24 slots cover desktop's
// 3 columns × several rows. Their icons load eagerly and skip content-visibility.
const EAGER = 24;
const PRIORITY = 6;
const screenOrder = new Map(
  groups.flatMap((g) => g.items.filter((b) => !isHeroBlessing(b.id))).map((b, i) => [b.id, i]),
);
---

<Base>
  <p id="count" slot="score" class="score bar" aria-live="polite">
    <b>{general.length}</b><small>福佑</small>
  </p>
  <h1 class="sr-only">福佑图鉴</h1>
  <div class="lookup">
    <div class="field">
      <label class="field-cap" for="q"><Icon name="search" size={22} /><span class="sr-only">搜索福佑</span></label>
      <input
        id="q"
        type="search"
        placeholder="名称 · 首字母 · 效果"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        enterkeyhint="search"
        autofocus
      />
      <button class="icon-btn field-clear" type="button" aria-label="清空搜索"><Icon name="close" /></button>
    </div>
  </div>
  <div class="filters">
    <div class="teams" role="group" aria-label="按品质筛选（再点一次取消）">
      {
        QUALITIES.map((q) => (
          <button class="team bar" type="button" data-q={q.id} data-quality={q.id} aria-pressed="false">
            <span class="lbl">{q.label}</span>
            <b data-tally={q.id}>{tally(q.id)}</b>
          </button>
        ))
      }
      <button class="team bar team-none" type="button" data-quality="none" aria-pressed="false">
        <span class="lbl">未标注</span><b data-tally="none">{tally(null)}</b>
      </button>
    </div>
    <div class="tagstrip" role="group" aria-label="标签筛选与英雄福佑开关">
      <button id="hero-toggle" class="switch bar" type="button" role="switch" aria-checked="false">
        <span class="knob" aria-hidden="true"></span>含英雄福佑<b class="num">{heroCount}</b>
      </button>
      {
        tags.map((t) => (
          <button class="chip bar" type="button" data-tag={t} aria-pressed="false">
            {t}
          </button>
        ))
      }
    </div>
  </div>
  <p id="hero-hint" class="hero-hint" hidden>
    有 <b class="num">0</b> 个英雄福佑匹配 · <button type="button" class="link-btn">显示</button>
  </p>
  {
    blessings.length === 0 && (
      <div class="empty-state">
        <h2>还没有收录福佑</h2>
        <p>运行 npm run import 从游戏文件导入。</p>
      </div>
    )
  }
  {/* Hide hero blessings before first paint so their lazy images never start; search-page takes over. */}
  <script is:inline>
    if (!/[?&]hero=1(&|$)/.test(location.search)) document.documentElement.classList.add('hb-off');
  </script>
  <div id="groups">
    {
      groups.map((g) => (
        <section class="group" data-group={g.id} data-q={g.q} aria-labelledby={`g-${g.id}`}>
          <h2 id={`g-${g.id}`} class="group-head">
            <span class="group-name">{g.label}</span>
            {/* Empty family: the teaching hint lives inside the header, so it stays one bar tall. */}
            <span class="group-empty" hidden={g.items.length > 0}>
              {g.q ? (
                <Fragment>
                  还没有 · <a href={url('/label/')}>去标注 <Icon name="next" /></a>
                </Fragment>
              ) : (
                '全部已标注'
              )}
            </span>
            {g.id === 'none' && (
              <button class="group-fold" type="button" hidden>
                <span>
                  显示 <span class="num" data-fold-shown>0</span> / <span class="num" data-fold-total>0</span>
                </span>
                <Icon name="chevron" size={18} />
              </button>
            )}
            <b class="num" data-group-tally>{g.items.filter((b) => !isHeroBlessing(b.id)).length}</b>
          </h2>
          <ul class="slots">
            {g.items.map((b) => {
              const hero = heroOf(b.id);
              const at = screenOrder.get(b.id);
              const first = at !== undefined && at < EAGER;
              return (
                <li data-id={b.id} data-hb={isHeroBlessing(b.id) ? '' : undefined} class={first ? 'now' : undefined}>
                  <BlessingCard blessing={b} hero={hero} eager={first} priority={first && at! < PRIORITY} />
                </li>
              );
            })}
          </ul>
          {g.id === 'none' && (
            <button class="btn bar group-more" type="button" hidden>
              展开全部 <span class="num">0</span> 个
            </button>
          )}
        </section>
      ))
    }
  </div>
  <ul id="results" class="slots" hidden></ul>
  <div id="no-result" class="empty-state" hidden>
    <h2>没有匹配的福佑</h2>
    <p>支持中文名、全拼、拼音首字母、英文名和效果关键词。试试：</p>
    <div class="try-list">
      <button class="try bar" type="button" data-try="dcsw"><code>dcsw</code>电锤思维（首字母）</button>
      <button class="try bar" type="button" data-try="复活"><code>复活</code>效果关键词</button>
      <button class="try bar" type="button" data-try="maelstrom"><code>maelstrom</code>英文名</button>
    </div>
    <button id="reset-filters" class="btn bar" type="button" hidden>清除品质和标签筛选</button>
  </div>
  <script type="application/json" id="search-data" set:html={safeJson(records)} />
  <script>
    import { initSearchPage } from '../scripts/search-page';
    initSearchPage();
  </script>
</Base>
