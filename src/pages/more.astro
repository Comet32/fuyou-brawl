---
// Fallback for the dock's 更多 when the popover sheet is unavailable (and a plain page for no-JS).
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { url } from '../lib/url';
---

<Base title="更多">
  <h1>更多</h1>
  <ul class="more-list">
    <li><a class="bar" href={url('/versions/')}><Icon name="versions" />版本变动<small>按时间倒序</small></a></li>
    <li><a class="bar" href={url('/guides/')}><Icon name="guides" />攻略文章<small>新手与进阶</small></a></li>
    <li><a class="bar" href={url('/label/')}><Icon name="label" />品质标注<small>站长工具</small></a></li>
  </ul>
</Base>
