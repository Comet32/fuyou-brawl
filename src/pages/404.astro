---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { url } from '../lib/url';
---

<Base title="找不到页面">
  <div class="lost">
    <p class="big num" aria-hidden="true">404</p>
    <h1 class="page-title">这一格是空的</h1>
    <p class="page-lede">链接可能过期了，或者这个福佑换了编号。回图鉴搜一下名字或拼音首字母，通常几秒就能找到。</p>
    <div class="btn-row">
      <a class="btn btn-gold bar" href={url('/')}><Icon name="search" />回图鉴搜索</a>
      <a class="btn bar" href={url('/compare/')}><Icon name="compare" />三选一对比</a>
    </div>
  </div>
</Base>
