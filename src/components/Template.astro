---
// Renders a game description template. Every piece of text goes through an Astro
// expression, so it is escaped; no raw HTML from the data ever reaches the page.
// Markup is kept minimal (plain text for the normal tone) because the catalog renders 675 of these.
// scripts/segments.ts renders the same classes on the client.
import { parseTemplate, type Tone } from '../lib/template';

interface Props {
  tpl: string;
  numbers?: Record<string, number | string>;
}
const { tpl, numbers } = Astro.props;
const segments = parseTemplate(tpl, numbers);
const TONE_CLASS: Record<Tone, string | undefined> = { normal: undefined, highlight: 'h', muted: 'm', accent: 'a' };
---

{
  segments.map((seg) =>
    seg.type === 'break' ? (
      <br />
    ) : seg.type === 'text' ? (
      TONE_CLASS[seg.tone] ? (
        <span class={TONE_CLASS[seg.tone]}>{seg.text}</span>
      ) : (
        seg.text
      )
    ) : seg.value !== undefined ? (
      <b class="v">{seg.value}</b>
    ) : (
      <i class="u" title={`${seg.key}：数值待补充`}>?</i>
    ),
  )
}
