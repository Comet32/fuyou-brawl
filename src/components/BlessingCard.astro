---
import type { Blessing } from '../lib/schema';
import { qualityOf } from '../lib/quality';
import { url } from '../lib/url';
import BlessingIcon from './BlessingIcon.astro';
import Template from './Template.astro';

interface Props {
  blessing: Blessing;
  note?: string;
  headingLevel?: 'h1' | 'h2' | 'h3';
}
const { blessing, note, headingLevel = 'h3' } = Astro.props;
const Tag = headingLevel;
const quality = qualityOf(blessing.quality);
---

<article class="blessing-card" style={`--q:${quality?.color ?? 'var(--border)'}`}>
  <BlessingIcon blessing={blessing} />
  <div>
    <Tag><a href={url(`/blessings/${blessing.id}/`)}>{blessing.name}</a></Tag>
    <p class="blessing-meta">
      {quality && <span class="q">{quality.label}</span>}
      {blessing.tags.map((t) => <span class="tag">{t}</span>)}
    </p>
    <p class="blessing-effect"><Template tpl={blessing.summary} numbers={blessing.numbers} /></p>
    {note && <p class="blessing-note">💡 {note}</p>}
  </div>
</article>
