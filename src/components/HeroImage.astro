---
import type { Hero } from '../lib/schema';
import { heroColor, heroPortrait } from '../lib/hero-portraits';
import { url } from '../lib/url';

interface Props {
  hero: Hero;
  /** 'tile': grid tiles and chips, prefer the 128px thumb; 'full': detail header. */
  variant?: 'tile' | 'full';
  /** Load immediately (first screen); otherwise lazy. */
  eager?: boolean;
  /** fetchpriority="high" for the very first tiles. */
  priority?: boolean;
}
const { hero, variant = 'tile', eager = false, priority = false } = Astro.props;
const { full, thumb } = heroPortrait(hero.id);
// The portrait's average color fills the 16:9 box until the image arrives (1–3 s on mainland networks).
const bg = heroColor(hero.id);
const style = bg ? `--hero-bg:${bg}` : undefined;
const tile = variant === 'tile' && thumb && full && thumb !== full;
---

{
  full ? (
    <img
      class="hero-img"
      data-attr={hero.attr}
      style={style}
      src={url(tile ? thumb! : full)}
      srcset={tile ? `${url(thumb!)} 128w, ${url(full)} 256w` : undefined}
      sizes={
        /* Desktop tiles take the 128px thumb; phones (2x screens, ~half-width tiles) take the sharp 256px portrait. */
        tile ? '(min-width: 721px) 128px, 50vw' : undefined
      }
      alt=""
      width="256"
      height="144"
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : undefined}
      decoding="async"
    />
  ) : (
    <span class="hero-img" data-attr={hero.attr} style={style} aria-hidden="true">
      {hero.name.slice(0, 1)}
    </span>
  )
}
